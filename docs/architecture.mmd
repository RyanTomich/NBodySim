flowchart TD
    M["main.c — CLI simulation orchestration"] --> IO["io.c / parse.c — state I/O and numeric parsing"]
    M --> S["state.c — state ownership and views"]
    M --> R["solver.c — backend lifecycle and metadata"]
    M --> E["leapfrog.c / euler.c — default leapfrog or explicit Euler"]
    E --> CB["AccelerationSolver — position-dependent forces"]
    CB --> N2["n2.c — direct all-pairs solver"]
    CB --> SB["serial_barnes_hut.c — serial baseline"]
    CB --> PB["parallel_barnes_hut.c — independent particle walks"]
    CB --> GB["grouped_barnes_hut.c — shared leaf traversal"]
    CB --> F["fmm.c — fast multipole solver"]
    SB --> G["gravity.c — direct particle interactions"]
    GB --> G
    F --> G
    SB --> O["octree.c — bounded spatial hierarchy"]
    GB --> O
    F --> O
    F --> GEN["generated/laplace_order4.h — unrolled order-4 translation"]

